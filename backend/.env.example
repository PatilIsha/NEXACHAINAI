# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/nexachain
# Set to "false" to force non-transactional writes (standalone MongoDB).
# When "true" the service tries multi-document transactions first and falls back
# automatically if the server is not a replica set.
USE_TRANSACTIONS=true

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- ROI scheduler ----
CRON_ENABLED=true
# Every day at 12:00 AM (midnight) in CRON_TIMEZONE
ROI_CRON_SCHEDULE=0 0 * * *
CRON_TIMEZONE=Asia/Kolkata
# Shared secret for the manual trigger endpoint (header: x-cron-secret)
CRON_SECRET=change-me-cron-secret

# ---- Business rules ----
# Referral income percentages per level (level 1 first)
LEVEL_INCOME_PERCENTAGES=10,5,3,2,1
# Require the upline user to have an active investment to receive level income
LEVEL_INCOME_REQUIRE_ACTIVE_INVESTMENT=false
